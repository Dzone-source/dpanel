# =============================================================================
# DPanel - Docker Environment
# Copy to .env and edit before running: cp .env.example .env
# =============================================================================

# Application
APP_NAME=DPanel
APP_URL=
TZ=Asia/Ho_Chi_Minh

# HTTP port exposed on the host (use 80, or 8080 if 80 is taken)
HTTP_PORT=80

# Security keys (install.sh auto-generates these if left empty)
APP_KEY=
MU_KEY=

# MariaDB
DB_HOST=mariadb
DB_PORT=3306
DB_ROOT_PASSWORD=
DB_DATABASE=dpanel
DB_USERNAME=dpanel
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Locale (Vietnamese only)
APP_LOCALE=vi_VN

# Admin account (used by install.sh for first-time setup)
ADMIN_EMAIL=
ADMIN_PASSWORD=
