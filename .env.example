# =============================================================================
# DPanel - Docker Environment
# Copy to .env and edit before running: cp .env.example .env
# =============================================================================

# Application
APP_NAME=DPanel
APP_URL=https://panel.example.com
TZ=Asia/Ho_Chi_Minh

# HTTP port exposed on the host (use 80, or 8080 if 80 is taken)
HTTP_PORT=80

# Security keys (install.sh auto-generates these if left empty)
APP_KEY=
MU_KEY=

# MariaDB
DB_HOST=mariadb
DB_PORT=3306
DB_ROOT_PASSWORD=change_me_root_password
DB_DATABASE=dpanel
DB_USERNAME=dpanel
DB_PASSWORD=change_me_db_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Admin account (used by install.sh for first-time setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
